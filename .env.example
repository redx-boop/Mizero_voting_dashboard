# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# Copy this file to .env.local for `npm run dev`.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Newer Supabase projects issue a publishable key (sb_publishable_...):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLIC-KEY
# ...or, for older projects, the legacy anon key (eyJ...):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NEVER add a service_role / secret key here. This key would ship to the
# browser and bypass every Row Level Security policy.
